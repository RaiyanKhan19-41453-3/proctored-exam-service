# =============================================================================
# Proctored Exam Service — copy to .env, never commit it
# =============================================================================
POSTGRES_DB=examservice
POSTGRES_USER=exam
POSTGRES_PASSWORD=REPLACE_WITH_DEV_PASSWORD
POSTGRES_PORT=15433

REDIS_PORT=16380

MINIO_ROOT_USER=exam
MINIO_ROOT_PASSWORD=REPLACE_WITH_DEV_PASSWORD
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011

API_PORT=18090
WEB_PORT=13010

# Must match the main platform's JWT_KEY exactly — tokens are shared across services.
JWT_KEY=REPLACE_WITH_THE_SAME_KEY_AS_THE_MAIN_PLATFORM
CORS_ORIGIN=http://localhost:13010

# Optional AI evaluator (OpenAI-compatible chat completions endpoint).
# Leave empty to use the built-in local heuristic analyzer.
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL=local-heuristic
