FROM mcr.microsoft.com/dotnet/sdk:10.0
WORKDIR /src
COPY . .
RUN dotnet restore src/ExamService.Api/ExamService.Api.csproj && dotnet tool restore
ENTRYPOINT ["dotnet", "ef", "database", "update", \
  "--project", "src/ExamService.Infrastructure/ExamService.Infrastructure.csproj", \
  "--startup-project", "src/ExamService.Api/ExamService.Api.csproj"]
